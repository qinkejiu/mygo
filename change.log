    ('blowfish', 120000),
    ('common', 1024),
    ('dfadd', 20000),
    ('dfdiv', 20000),
    ('dfmul', 20000),
    ('dfsin', 40000),
    ('gsm', 60000),
    ('mips', 120000),
    ('motion', 60000),
    ('sha', 80000),
]
env = os.environ.copy()
env['GOCACHE'] = '/home/qinkejiu/mygo/.gocache'
env['GOMODCACHE'] = '/home/qinkejiu/mygo/.cache/gomod'
for case, cycles in cases:
    src = f'tests/CHStone/{case}/main.go'
    print(f'CASE {case} start cycles={cycles}', flush=True)
    sw = subprocess.run(['go', 'run', src], cwd=root, env=env, text=True, capture_output=True, timeout=600)
    if sw.returncode != 0:
        print(f'CASE {case} software FAIL rc={sw.returncode}')
        print(sw.stdout[-1000:])
        print(sw.stderr[-1000:])
        continue
    with tempfile.NamedTemporaryFile('w', delete=False, dir='/tmp', prefix=f'{case}-', suffix='.expect') as fh:
        fh.write(sw.stdout)
        expect = fh.name
        hw = subprocess.run(
            ['go', 'run', './cmd/mygo', 'sim', '--sim-max-cycles', str(cycles), '--expect', expect, src],
            cwd=root, env=env, text=True, capture_output=True, timeout=1200,
        )
    finally:
        try:
            os.unlink(expect)
        except FileNotFoundError:
            pass
    marker = 'make: Entering directory' in hw.stderr or 'make: Leaving directory' in hw.stderr
    if hw.returncode == 0:
        mode = 'verilator' if marker else 'fallback-or-quiet'
        print(f'CASE {case} PASS hw={mode}')
    else:
        print(f'CASE {case} FAIL hw_rc={hw.returncode} hw_make={marker}')
